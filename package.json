{
  "name": "eegkit",
  "version": "0.1.0",
  "description": "Real-time EEG signal processing for JavaScript: filters, band power, neurofeedback metrics and signal quality. Zero dependencies, runs in browsers, Node, React Native and Web Workers.",
  "keywords": [
    "eeg",
    "bci",
    "brain-computer-interface",
    "neurofeedback",
    "dsp",
    "signal-processing",
    "band-power",
    "welch",
    "butterworth",
    "fft",
    "edf",
    "react-native"
  ],
  "license": "MIT",
  "author": "Ali Assar <ali.assar37@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliassar/eegkit.git"
  },
  "homepage": "https://github.com/aliassar/eegkit#readme",
  "bugs": "https://github.com/aliassar/eegkit/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "fixtures": "uv run --with numpy --with scipy python scripts/make_fixtures.py",
    "prepare": "tsup",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "~5.9",
    "vitest": "^5.1.0"
  }
}
